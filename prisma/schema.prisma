// ImmigrationCaseTracker data model.
//
// Two kinds of case owner, modelled explicitly (guide §19.2): a TrackedCase
// belongs to exactly ONE of an individual user (B2C) or a firm (B2B). The
// database enforces that with a CHECK constraint added in the migration SQL
// (Prisma can't express it).
//
// Authentication is Supabase Auth; User.id is the Supabase auth user id.
//
// Receipt numbers are sensitive personal case identifiers. They're stored
// only encrypted (AES-256-GCM, src/lib/crypto.ts) plus a keyed HMAC digest
// for duplicate detection and a masked hint for display — never in plain text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// Individual plan. Billing (later) switches it; until then set it by hand.
enum Plan {
  FREE
  PREMIUM
}

model User {
  /// Same id as the Supabase Auth user (auth.users.id). Supabase Auth owns
  /// passwords, email verification, sessions and MFA; this table holds our
  /// profile and is created on the user's first authenticated request.
  id               String    @id
  email            String    @unique
  name             String?
  /// "en" | "es" — UI language and which USCIS status text to show first.
  locale           String    @default("en")
  /// Set when the user turns on two-factor (TOTP) through our settings page;
  /// cleared when they turn it off. The server requires an aal2 session for
  /// these users. Authoritative — unlike the client-editable session cookie.
  mfaEnrolledAt    DateTime?
  plan             Plan      @default(FREE)
  /// Stripe customer for Premium billing (Step 8). Never a card or bank detail.
  stripeCustomerId String?   @unique
  /// End of the new-account Premium trial (7 days). Null = never had one.
  trialEndsAt      DateTime?
  /// Trial emails sent: 0 none, 1 "ends soon", 2 "ended".
  trialNoticeStage Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notificationPreference NotificationPreference?
  memberships            FirmMembership[]
  ownedCases             TrackedCase[]           @relation("CaseOwner")
  addedCases             TrackedCase[]           @relation("CaseAddedBy")
  assignedCases          TrackedCase[]           @relation("CaseAssignee")
  defaultAssigneeOf      Firm[]                  @relation("FirmDefaultAssignee")
  clientsCreated         Client[]                @relation("ClientCreatedBy")
  firmUpdatesAssigned    FirmUpdate[]            @relation("FirmUpdateAssignee")
  firmUpdatesResolved    FirmUpdate[]            @relation("FirmUpdateResolver")
  firmUpdatesSent        FirmUpdate[]            @relation("FirmUpdateSender")
  deadlinesCreated       CaseDeadline[]          @relation("DeadlineCreatedBy")
  tasksAssigned          FirmTask[]              @relation("TaskAssignee")
  tasksCreated           FirmTask[]              @relation("TaskCreatedBy")
  tasksCompleted         FirmTask[]              @relation("TaskCompletedBy")
  taskComments           FirmTaskComment[]       @relation("TaskCommentAuthor")
  mattersCreated         FirmMatter[]            @relation("MatterCreatedBy")
  documentsUploaded      FirmDocument[]          @relation("DocumentUploadedBy")
  docRequestsCreated     DocumentRequest[]       @relation("DocRequestCreatedBy")
  docItemsReviewed       DocumentRequestItem[]   @relation("DocItemReviewedBy")
  deadlinesDone          CaseDeadline[]          @relation("DeadlineDoneBy")
  consentsGranted        CaseConsent[]           @relation("ConsentGrantedBy")
  consentsWithdrawn      CaseConsent[]           @relation("ConsentWithdrawnBy")
  invitationsSent        FirmInvitation[]
  notificationDeliveries NotificationDelivery[]
  auditLogs              AuditLog[]
  deletionRequests       DeletionRequest[]
  subscriptions          Subscription[]
  pushDevices            PushDevice[]
  visaBulletinWatch      VisaBulletinWatch?
  assistantUsage         AssistantUsage[]
  caseTags               CaseTag[]
  checklistChecks        ChecklistCheck[]
}

model NotificationPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOnChange Boolean  @default(true)
  pushOnChange  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Law firms (B2B tenancy)
// ---------------------------------------------------------------------------

enum FirmStatus {
  ACTIVE
  SUSPENDED
}

enum FirmRole {
  OWNER
  ADMIN
  STAFF
}

model Firm {
  id                String           @id @default(cuid())
  name              String
  status            FirmStatus       @default(ACTIVE)
  /// Case limit: the trial's 10, then the paid plan's (Firm Solo 50, Firm 300).
  caseLimit         Int              @default(10)
  /// End of the free trial (14 days, 10 cases).
  trialEndsAt       DateTime?
  /// Paid plan, set from Stripe. Null = no active subscription (trial or lapsed).
  plan              FirmPlan?
  /// Stripe customer for the firm's billing (Step 8).
  stripeCustomerId  String?          @unique
  /// What a client hears when their case changes: nothing, a message staff approve first, or an automatic message.
  clientUpdates     ClientUpdateMode @default(OFF)
  /// Where clients' replies to update emails go (Reply-To). Null: no reply address.
  replyToEmail      String?
  /// One line shown to clients on how to reach the firm (phone, hours).
  clientContactLine String?
  /// Flag a case in Updates when USCIS hasn't changed it in this many days (0 = off).
  stuckAfterDays    Int              @default(90)
  /// Remind in Updates this many days before a case deadline.
  deadlineLeadDays  Int              @default(7)
  /// The firm's time zone (IANA name): "today" for deadlines and reminders.
  timeZone          String           @default("America/New_York")
  /// New cases go to this member unless someone else is chosen. Null: whoever adds the case.
  defaultAssigneeId String?
  defaultAssignee   User?            @relation("FirmDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  /// The firm's logo (encrypted in the file store) for the client portal, upload page and client emails. Null: no logo.
  logoKey           String?
  logoContentType   String?
  /// Goes up with every new logo, so cached copies are replaced.
  logoVersion       Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  memberships      FirmMembership[]
  invitations      FirmInvitation[]
  clients          Client[]
  cases            TrackedCase[]
  auditLogs        AuditLog[]
  deletionRequests DeletionRequest[]
  subscriptions    Subscription[]
  tags             FirmTag[]
  updates          FirmUpdate[]
  deadlines        CaseDeadline[]
  tasks            FirmTask[]
  taskComments     FirmTaskComment[]
  matters          FirmMatter[]
  documents        FirmDocument[]
  docRequests      DocumentRequest[]
}

enum FirmPlan {
  SOLO
  FIRM
  PLUS
}

model FirmMembership {
  id             String    @id @default(cuid())
  firmId         String
  firm           Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           FirmRole  @default(STAFF)
  /// Job title shown on the team page: ATTORNEY, PARALEGAL, LEGAL_ASSISTANT, OTHER. Null: not set. Roles decide permissions; titles don't.
  title          String?
  /// Last time this person opened the firm workspace (updated at most every few minutes).
  lastActiveAt   DateTime?
  /// Inbox opens on "mine" (assigned to me) or "all" (whole firm).
  inboxView      String    @default("all")
  /// Email me when USCIS changes a case: "none", "mine" (cases assigned to me) or "all" (every firm case).
  caseEmails     String    @default("none")
  /// Which kinds of change those emails cover (status categories: action, done, stop, progress).
  caseEmailKinds String[]  @default(["action", "done", "stop"])
  /// While away (through this day, in the firm's time zone), new inbox items for me go to my backup.
  awayUntil      DateTime? @db.Date
  backupUserId   String?
  /// Revocation takes effect immediately: every firm check filters revokedAt IS NULL.
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([firmId, userId])
  @@index([userId])
}

model FirmInvitation {
  id          String    @id @default(cuid())
  firmId      String
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  email       String
  role        FirmRole  @default(STAFF)
  /// SHA-256 of the invite token; the token itself is only in the emailed link.
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([firmId])
}

/// A law firm's client. Deliberately minimal contact data (guide §19.2).
model Client {
  id               String    @id @default(cuid())
  firmId           String
  firm             Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  displayName      String
  firstName        String?
  lastName         String?
  /// Encrypted (AES-GCM): "YYYY-MM-DD".
  dateOfBirthEnc   String?
  /// ISO 3166 two-letter codes.
  countryOfBirth   String?
  citizenship      String?
  /// Encrypted (AES-GCM): the nine-digit A-Number. Only the last 4 digits are kept in the clear, for display.
  aNumberEnc       String?
  aNumberLast4     String?
  email            String?
  phone            String?
  /// The firm's own reference for this client (matter number etc.).
  externalRef      String?
  /// Language for update emails and the client's status page: "en" or "es".
  locale           String    @default("en")
  /// When the firm recorded that the client agreed to receive case updates by email. Null: no updates.
  updatesConsentAt DateTime?
  /// The client's status page link works only while enabled; a new version makes earlier links stop working.
  portalEnabled    Boolean   @default(false)
  portalVersion    Int       @default(1)
  createdById      String?
  createdBy        User?     @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cases       TrackedCase[]
  tasks       FirmTask[]
  documents   FirmDocument[]
  docRequests DocumentRequest[]

  /// Lets TrackedCase reference (clientId, firmId) so a case can never point
  /// at another firm's client.
  @@unique([id, firmId])
  @@index([firmId])
}

// ---------------------------------------------------------------------------
// Cases
// ---------------------------------------------------------------------------

enum TrackingStatus {
  /// Polled on schedule.
  ACTIVE
  /// Owner paused monitoring, or consent was withdrawn — no USCIS calls.
  PAUSED
}

enum CheckTrigger {
  INITIAL
  MANUAL
  SCHEDULED
}

model TrackedCase {
  id String @id @default(cuid())

  // Exactly one of ownerUserId / firmId is set (CHECK constraint in SQL).
  ownerUserId String?
  ownerUser   User?   @relation("CaseOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  firmId      String?
  firm        Firm?   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// Firm cases only. Composite FK guarantees the client belongs to the same firm.
  clientId    String?
  client      Client? @relation(fields: [clientId, firmId], references: [id, firmId], onDelete: NoAction)

  addedById  String?
  addedBy    User?       @relation("CaseAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  /// The matter (family, employer, lawsuit...) the case belongs to, if any. Same firm, checked by the service.
  matterId   String?
  matter     FirmMatter? @relation(fields: [matterId], references: [id], onDelete: SetNull)
  /// The team member responsible for this case: its updates and alerts go to them.
  assigneeId String?
  assignee   User?       @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// AES-256-GCM ciphertext of the normalized receipt number.
  receiptEncrypted String
  /// Keyed HMAC digest of the normalized receipt — duplicate detection.
  receiptDigest    String
  /// Display hint only, e.g. "EAC*******402".
  receiptMasked    String
  /// Owner-chosen label, e.g. "Mom's I-130".
  nickname         String?

  trackingStatus TrackingStatus @default(ACTIVE)
  /// Why tracking is paused: "plan_limit" (over the Free plan's 1 case; resumes
  /// on upgrade) or null (paused by the owner or consent).
  pausedReason   String?

  // Latest known USCIS state (status texts are USCIS's public wording).
  formType            String?
  statusTitleEn       String?
  statusTitleEs       String?
  statusDescriptionEn String?
  statusDescriptionEs String?
  /// Dates exactly as USCIS reported them (zone unspecified by USCIS).
  uscisSubmittedRaw   String?
  uscisModifiedRaw    String?
  /// USCIS-provided history (hist_case_status), normalized. Source data —
  /// distinct from CaseStatusEvent, which records what WE observed and when.
  uscisHistory        Json?
  statusFingerprint   String?
  /// USCIS connection the current status came from: "mock", "sandbox" or "production" (set on each successful check).
  /// Case insights only use statuses from the connection the site runs on.
  statusSource        String?

  /// Last time we asked USCIS (success or failure).
  lastCheckedAt         DateTime?
  /// Outcome of that check: "ok" or a UscisError kind.
  lastCheckOutcome      String?
  /// HTTP status of that check (null when USCIS wasn't reached).
  lastCheckHttpStatus   Int?
  /// USCIS's own error message from that check, receipt number masked. Null after a success.
  lastCheckUscisMessage String?
  /// Last time we observed the status change. Shown separately from lastCheckedAt.
  lastChangeObservedAt  DateTime?
  /// When the scheduler should next poll this case.
  nextCheckAt           DateTime?
  /// For backoff / circuit breaking on repeated failures.
  consecutiveFailures   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents    CaseConsent[]
  events      CaseStatusEvent[]
  checkRuns   CaseCheckRun[]
  tags        TrackedCaseTag[]
  firmTags    FirmCaseTag[]
  firmUpdates FirmUpdate[]
  deadlines   CaseDeadline[]
  tasks       FirmTask[]
  documents   FirmDocument[]
  docRequests DocumentRequest[]

  @@unique([ownerUserId, receiptDigest])
  @@unique([firmId, receiptDigest])
  /// Lets a tag link require the case's owner (see TrackedCaseTag).
  @@unique([id, ownerUserId])
  /// Lets a firm tag link require the case's firm (see FirmCaseTag).
  @@unique([id, firmId])
  @@index([trackingStatus, nextCheckAt])
  @@index([clientId])
  @@index([statusSource, formType])
  @@index([firmId, assigneeId])
  @@index([matterId])
}

enum ConsentBasis {
  /// "This is my own case."
  SELF
  /// "I'm authorized by the applicant (e.g. a family member) to track it."
  AUTHORIZED_BY_APPLICANT
  /// Firm: attorney/accredited representative of record (e.g. G-28 on file).
  LEGAL_REPRESENTATIVE
}

enum ConsentSource {
  WEB
  MOBILE
  FIRM_ATTESTATION
  CSV_IMPORT
}

/// Express consent to track a case (guide §9, §19.1). A case is only polled
/// while it has an active (not withdrawn) consent.
model CaseConsent {
  id               String        @id @default(cuid())
  caseId           String
  case             TrackedCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  basis            ConsentBasis
  source           ConsentSource
  /// Version of the consent wording the user agreed to (kept in code).
  statementVersion String
  /// Firm cases: reference to consent evidence on file (no documents stored here).
  evidenceRef      String?
  grantedById      String?
  grantedBy        User?         @relation("ConsentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  capturedAt       DateTime      @default(now())
  withdrawnAt      DateTime?
  withdrawnById    String?
  withdrawnBy      User?         @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)

  @@index([caseId, withdrawnAt])
}

/// A status change WE observed (first time we saw a new fingerprint).
model CaseStatusEvent {
  id                  String      @id @default(cuid())
  caseId              String
  case                TrackedCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  formType            String?
  statusTitleEn       String?
  statusTitleEs       String?
  statusDescriptionEn String?
  statusDescriptionEs String?
  /// USCIS's modifiedDate as reported, if any.
  uscisReportedRaw    String?
  fingerprint         String
  firstObservedAt     DateTime    @default(now())

  deliveries NotificationDelivery[]
  firmUpdate FirmUpdate?

  @@unique([caseId, fingerprint])
  @@index([caseId, firstObservedAt])
}

/// Sanitized operational record of every USCIS call for a case. No payloads.
model CaseCheckRun {
  id                String       @id @default(cuid())
  caseId            String
  case              TrackedCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  trigger           CheckTrigger
  uscisEnv          String
  httpStatus        Int?
  outcome           String
  durationMs        Int
  changed           Boolean      @default(false)
  attemptedAt       DateTime     @default(now())
  /// From USCIS's error body on a failed check (receipt number masked).
  uscisErrorCode    String?
  uscisErrorMessage String?
  /// USCIS's traceId / reference, for asking USCIS support about this request.
  uscisTraceId      String?

  @@index([caseId, attemptedAt])
  @@index([attemptedAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  eventId        String
  event          CaseStatusEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  /// event + user + channel — a retried job never sends twice.
  idempotencyKey String              @unique
  error          String?
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  firmId      String?
  firm        Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// e.g. "case.created", "consent.withdrawn", "member.revoked"
  action      String
  targetType  String
  targetId    String
  /// Minimal, non-sensitive context. Never receipt numbers or USCIS payloads.
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([firmId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

enum DeletionScope {
  ACCOUNT
  CASE
  FIRM
}

enum DeletionStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model DeletionRequest {
  id             String         @id @default(cuid())
  requesterId    String?
  requester      User?          @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  /// Email at request time, so the record survives the account's deletion.
  requesterEmail String
  firmId         String?
  firm           Firm?          @relation(fields: [firmId], references: [id], onDelete: SetNull)
  scope          DeletionScope
  targetId       String?
  status         DeletionStatus @default(REQUESTED)
  notes          String?
  requestedAt    DateTime       @default(now())
  completedAt    DateTime?

  @@index([status, requestedAt])
}

enum BillingProduct {
  PREMIUM
  FIRM_SOLO
  FIRM
  FIRM_PLUS
}

/// A Stripe subscription, mirrored from Stripe webhooks (Stripe stays the
/// source of truth; this row is re-synced from the API on every event).
/// Exactly one of userId / firmId is set (CHECK constraint in SQL).
model Subscription {
  id                   String         @id @default(cuid())
  stripeSubscriptionId String         @unique
  stripeCustomerId     String
  userId               String?
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  firmId               String?
  firm                 Firm?          @relation(fields: [firmId], references: [id], onDelete: SetNull)
  product              BillingProduct
  /// "month" | "year"
  interval             String
  /// Stripe status: active, trialing, past_due, canceled, unpaid, incomplete...
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean        @default(false)
  /// When the subscription first became past_due (grace period start).
  pastDueSince         DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([firmId])
}

/// Stripe webhook events already processed (idempotency). Ids only.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// A phone that registered for push alerts (Expo push token). Token only:
/// no device identifiers, contacts or location.
model PushDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "ExponentPushToken[...]"
  token      String    @unique
  /// "ios" | "android"
  platform   String
  appVersion String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set when Expo reports the token is no longer valid, or on sign-out.
  disabledAt DateTime?

  @@index([userId])
}

/// One-way fingerprints (keyed HMAC) of emails and receipt numbers that have
/// already had a Premium trial, so deleting an account or making a new email
/// doesn't give another one. Never the email or receipt itself. Kept 12 months.
model TrialLedger {
  key       String   @id
  /// "email" | "receipt"
  kind      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Visa Bulletin (U.S. Department of State)
// ---------------------------------------------------------------------------

/// One month's Visa Bulletin, imported by an admin (the State Department site
/// blocks automated downloads, so an admin pastes the published bulletin).
/// Not used since Nov 2026: CasePingo links to the State Department's bulletin instead of importing it.
/// Kept (empty) so nothing is dropped; remove with a migration once that's settled.
model VisaBulletin {
  id           String   @id @default(cuid())
  /// "2026-12": the month the bulletin is for.
  month        String   @unique
  /// The official bulletin page, for people to check.
  sourceUrl    String?
  /// The four charts (src/lib/visa-bulletin/model.ts: Charts).
  charts       Json
  importedAt   DateTime @default(now())
  /// Admin who imported it (kept even if that account is later deleted).
  importedById String?
}

/// The Visa Bulletin category a person follows: shown first in the app, and
/// alerted when it moves (Premium), once per bulletin month.
/// Not used since Nov 2026 (see VisaBulletin). Kept so no saved choices are dropped.
model VisaBulletinWatch {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Category key, e.g. "F2A" or "EB2".
  category          String
  /// Chargeability area: ALL, CHINA, INDIA, MEXICO or PHILIPPINES.
  area              String
  /// The chart they look at first: "final" (final action dates) or "filing" (dates for filing).
  chart             String   @default("final")
  /// The last bulletin month we alerted them about.
  lastNotifiedMonth String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Assistant
// ---------------------------------------------------------------------------

/// How many assistant questions a person asked on a UTC day, for the plan's
/// daily limit. Never the questions or answers: conversations aren't stored.
/// Rows older than 30 days are deleted (src/lib/assistant/usage.ts).
model AssistantUsage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// UTC day, "2026-11-06".
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, day])
  @@index([day])
}

/// A label someone puts on their own cases ("Family", "Work") to group and
/// filter them. Personal cases only for now (firm cases have no owner).
model CaseTag {
  id          String           @id @default(cuid())
  ownerUserId String
  owner       User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// As typed (trimmed, single spaces), up to 24 characters.
  name        String
  /// Lowercased name, so "Family" and "family" are one tag.
  nameKey     String
  /// One of TAG_COLORS in src/lib/cases/tags.ts.
  color       String           @default("blue")
  createdAt   DateTime         @default(now())
  cases       TrackedCaseTag[]

  @@unique([ownerUserId, nameKey])
  @@unique([id, ownerUserId])
}

/// A tag on a case. Both foreign keys include the owner, so the database
/// itself only allows a person's own tag on their own case.
model TrackedCaseTag {
  caseId      String
  tagId       String
  ownerUserId String
  case        TrackedCase @relation(fields: [caseId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  tag         CaseTag     @relation(fields: [tagId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@id([caseId, tagId])
  @@index([tagId])
}

/// A label a firm's team shares on the firm's cases ("Attorney: Smith",
/// "H-1B", "RFE due"). Any member can create and use them; Owners and Admins
/// rename, recolor and delete them.
model FirmTag {
  id        String        @id @default(cuid())
  firmId    String
  firm      Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// As typed (trimmed, single spaces), up to 32 characters.
  name      String
  /// Lowercased name, so "H-1B" and "h-1b" are one tag.
  nameKey   String
  /// One of TAG_COLORS in src/lib/cases/tags.ts.
  color     String        @default("blue")
  createdAt DateTime      @default(now())
  cases     FirmCaseTag[]

  @@unique([firmId, nameKey])
  @@unique([id, firmId])
}

/// A firm tag on one of the firm's cases. Both foreign keys include the firm,
/// so the database itself only allows a firm's own tag on its own case.
model FirmCaseTag {
  caseId    String
  tagId     String
  firmId    String
  case      TrackedCase @relation(fields: [caseId, firmId], references: [id, firmId], onDelete: Cascade)
  tag       FirmTag     @relation(fields: [tagId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([caseId, tagId])
  @@index([tagId])
}

/// Document checklists (src/lib/checklists.ts): the items a person has ticked as gathered.
/// Only the item keys are stored, never documents.
model ChecklistCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Checklist key, e.g. "i-485".
  checklist String
  /// Item key within the checklist, e.g. "i693".
  item      String
  checkedAt DateTime @default(now())

  @@unique([userId, checklist, item])
  @@index([userId, checklist])
}

/// A firm case's status change in the firm's Updates inbox: who handles it, and
/// whether the client was told. One per status change (the case's first status isn't one).
model FirmUpdate {
  id                String            @id @default(cuid())
  firmId            String
  firm              Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// Null for task items that aren't about a case.
  caseId            String?
  /// Composite key: the case always belongs to the same firm.
  case              TrackedCase?      @relation(fields: [caseId, firmId], references: [id, firmId], onDelete: Cascade)
  /// A status change (event), a case with no change for a long time (stuck), or a deadline reminder.
  kind              FirmUpdateKind    @default(STATUS_CHANGE)
  eventId           String?           @unique
  event             CaseStatusEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deadlineId        String?
  deadline          CaseDeadline?     @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  taskId            String?
  task              FirmTask?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestId         String?
  request           DocumentRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// One alert per situation: "stuck:<case>:<status fingerprint>" or "deadline:<id>:soon|overdue".
  alertKey          String?           @unique
  /// Days without a USCIS change when a stuck alert was raised.
  stuckDays         Int?
  state             FirmUpdateState   @default(OPEN)
  assignedToId      String?
  assignedTo        User?             @relation("FirmUpdateAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Snoozed updates come back to Open at this time.
  snoozedUntil      DateTime?
  resolvedById      String?
  resolvedBy        User?             @relation("FirmUpdateResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?
  /// The message to the client about this change.
  clientUpdate      ClientUpdateState @default(NONE)
  clientUpdateAt    DateTime?
  clientUpdateById  String?
  clientUpdateBy    User?             @relation("FirmUpdateSender", fields: [clientUpdateById], references: [id], onDelete: SetNull)
  clientUpdateError String?
  createdAt         DateTime          @default(now())

  @@index([firmId, state, createdAt])
  @@index([caseId])
  @@index([deadlineId])
  @@index([taskId])
  @@index([requestId])
}

/// A to-do for the firm's team, optionally about a case or a client.
model FirmTask {
  id            String            @id @default(cuid())
  firmId        String
  firm          Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        FirmTaskStatus    @default(TODO)
  type          FirmTaskType      @default(GENERAL)
  priority      FirmTaskPriority  @default(NONE)
  dueOn         DateTime?         @db.Date
  assigneeId    String?
  assignee      User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Same firm, checked by the service; the link clears if the case or client is removed.
  caseId        String?
  case          TrackedCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matterId      String?
  matter        FirmMatter?       @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  completedById String?
  completedBy   User?             @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  comments      FirmTaskComment[]
  updates       FirmUpdate[]

  @@index([firmId, status, dueOn])
  @@index([firmId, assigneeId, status])
  @@index([caseId])
  @@index([clientId])
  @@index([matterId])
}

/// A group of related cases: a family, an employer's petitions, a lawsuit, or anything the firm names.
model FirmMatter {
  id          String        @id @default(cuid())
  firmId      String
  firm        Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name        String
  /// Lower-case name, unique within the firm.
  nameKey     String
  kind        MatterKind    @default(CUSTOM)
  description String?
  archivedAt  DateTime?
  createdById String?
  createdBy   User?         @relation("MatterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cases       TrackedCase[]
  tasks       FirmTask[]

  @@unique([firmId, nameKey])
  @@index([firmId, archivedAt])
}

/// A file a firm keeps for a case or client. Stored encrypted (AES-256-GCM) in private storage; only its metadata is here.
model FirmDocument {
  id            String               @id @default(cuid())
  firmId        String
  firm          Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// Same firm, checked by the service.
  caseId        String?
  case          TrackedCase?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name          String
  kind          DocumentKind         @default(OTHER)
  visibility    DocumentVisibility   @default(INTERNAL)
  source        DocumentSource       @default(FIRM)
  contentType   String
  size          Int
  sha256        String
  /// How the file was checked before it was stored: "basic" (built-in checks) or "cloudmersive" (malware scan too). Null: uploaded before checks existed.
  scannedWith   String?
  storageKey    String               @unique
  uploadedById  String?
  uploadedBy    User?                @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// The request item a client uploaded this for, if any.
  requestItemId String?
  requestItem   DocumentRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([firmId, createdAt])
  @@index([caseId])
  @@index([clientId])
}

/// A list of documents the firm asks a client to upload, by a private link (no account needed).
model DocumentRequest {
  id             String                @id @default(cuid())
  firmId         String
  firm           Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Same firm, checked by the service.
  caseId         String?
  case           TrackedCase?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title          String
  message        String?
  dueOn          DateTime?             @db.Date
  status         DocumentRequestStatus @default(OPEN)
  /// A new version makes earlier links stop working.
  linkVersion    Int                   @default(1)
  createdById    String?
  createdBy      User?                 @relation("DocRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentAt         DateTime?
  remindersSent  Int                   @default(0)
  lastReminderAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          DocumentRequestItem[]
  updates        FirmUpdate[]

  @@index([firmId, status, createdAt])
  @@index([clientId])
  @@index([caseId])
}

model DocumentRequestItem {
  id           String            @id @default(cuid())
  requestId    String
  request      DocumentRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  label        String
  /// Spanish label, when it came from a bilingual checklist.
  labelEs      String?
  note         String?
  required     Boolean           @default(true)
  position     Int
  status       RequestItemStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedBy   User?             @relation("DocItemReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  documents    FirmDocument[]

  @@index([requestId, position])
}

enum DocumentRequestStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum RequestItemStatus {
  PENDING
  UPLOADED
  ACCEPTED
  REJECTED
}

enum DocumentKind {
  USCIS_NOTICE
  IDENTITY
  CIVIL
  FINANCIAL
  EVIDENCE
  FORM
  CORRESPONDENCE
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  CLIENT
}

enum DocumentSource {
  FIRM
  CLIENT
}

enum MatterKind {
  FAMILY
  EMPLOYER
  LAWSUIT
  CUSTOM
}

model FirmTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      FirmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  /// Team members @mentioned in the comment (user ids).
  mentions  String[]
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

enum FirmTaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
}

enum FirmTaskType {
  GENERAL
  CLIENT_FOLLOW_UP
  FORM_PREP
  FILING
  RESPONSE
  REVIEW
}

enum FirmTaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// A date the firm must not miss on a case (from a USCIS notice or the firm's own plan). Entered by the firm.
model CaseDeadline {
  id          String       @id @default(cuid())
  firmId      String
  firm        Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  caseId      String
  case        TrackedCase  @relation(fields: [caseId, firmId], references: [id, firmId], onDelete: Cascade)
  kind        DeadlineKind
  dueOn       DateTime     @db.Date
  note        String?
  doneAt      DateTime?
  doneById    String?
  doneBy      User?        @relation("DeadlineDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation("DeadlineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  updates     FirmUpdate[]

  @@index([firmId, doneAt, dueOn])
  @@index([caseId])
}

enum FirmUpdateKind {
  STATUS_CHANGE
  STUCK
  DEADLINE
  TASK
  DOCUMENT
}

enum DeadlineKind {
  RFE_RESPONSE
  NOID_RESPONSE
  INTERVIEW
  BIOMETRICS
  FILING
  OTHER
}

enum ClientUpdateMode {
  OFF
  REVIEW
  AUTO
}

enum FirmUpdateState {
  OPEN
  SNOOZED
  DONE
}

enum ClientUpdateState {
  /// The firm doesn't send client updates.
  NONE
  /// No client email or no recorded agreement: the client isn't told.
  NO_CLIENT
  /// Waiting for staff to send or skip it (review mode).
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}
