# Copy to .env and fill in. Never commit .env.
# Same pattern as Scanvio: secrets are server-only environment variables —
# .env locally, Vercel Project → Settings → Environment Variables in production.
# Nothing here may be prefixed NEXT_PUBLIC_ / EXPO_PUBLIC_.

# ---- Database (Supabase) ---------------------------------------------------
# The NEW ImmigrationCaseTracker Supabase project — never Scanvio's.
# Supabase dashboard → your project → Connect → "ORM" tab (Prisma) gives both:
#   DATABASE_URL = Transaction pooler, port 6543, ends with ?pgbouncer=true
#                  (what the app uses at runtime — required on Vercel;
#                  connection_limit=1 suits serverless functions)
#   DIRECT_URL   = Session pooler, port 5432
#                  (what Prisma uses for migrations; works on IPv4 networks)
# Replace [YOUR-PASSWORD] with the database password you set for the project.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- USCIS Case Status API -------------------------------------------------
# sandbox | production. Production is used ONLY after USCIS approval, with the
# endpoint and credentials USCIS issues — never guessed.
USCIS_ENV=sandbox
# Optional for sandbox (defaults to https://api-int.uscis.gov). Required for production.
USCIS_BASE_URL=
# From developer.uscis.gov → Teams → your team → Team Apps → ImmigrationCaseTracker → Credentials
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
# Four-digit demo id USCIS emails during the production-access demo (sent as a header).
USCIS_DEMO_ID=
# true = deterministic fake USCIS (local dev / demos). Also on automatically
# when the credentials above are empty. Refused on the production deployment.
MOCK_USCIS=

# ---- Encryption ------------------------------------------------------------
# AES-256-GCM key for receipt numbers at rest + keyed digests.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
